APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=etigo_api
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
UPLOADS_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_SCHEME=tls

# Mail (Resend HTTP API — bypasses SMTP port restrictions)
# Get your API key at https://resend.com/api-keys
# Verify etigo.com domain at https://resend.com/domains
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="noreply@etigo.com"
MAIL_FROM_NAME="${APP_NAME}"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Termii Messaging (WhatsApp + SMS fallback)
TERMII_API_KEY=
TERMII_SENDER_ID=Etigo
#TERMII_WHATSAPP_FROM=   # WhatsApp device name (defaults to TERMII_SENDER_ID)
ETIGO_SAFETY_NUMBER=
#ETIGO_SAFETY_LINE=      # Number riders call, shown on the tracking page (defaults to ETIGO_SAFETY_NUMBER)

# Third-party bookings (Phase 2) — operations can override these at /admin/settings/third-party
#THIRD_PARTY_BOOKINGS_ENABLED=true
#THIRD_PARTY_PIN_RECIPIENT=both        # booker, rider or both
#THIRD_PARTY_TRACKING_RECIPIENT=both
#THIRD_PARTY_ALLOW_CASH=false
#THIRD_PARTY_ALLOW_BANK_TRANSFER=false
#THIRD_PARTY_MAX_ACTIVE_PER_BOOKER=2
#THIRD_PARTY_MAX_RIDER_NUMBERS_PER_DAY=10
#THIRD_PARTY_RIDER_TRIP_UPDATES=true
#THIRD_PARTY_TRACKING_URL=             # defaults to ${APP_URL}/track/{ride}/{token}

# Lost & Found (Phase 2) — operations can override these at /admin/settings/lost-and-found
#LOST_AND_FOUND_ENABLED=true
#LOST_AND_FOUND_REPORT_WINDOW_DAYS=30
#LOST_AND_FOUND_MAX_OPEN_REPORTS=3
#LOST_AND_FOUND_DRIVER_RESPONSE_HOURS=24
#LOST_AND_FOUND_RETURN_DEADLINE_DAYS=7
#LOST_AND_FOUND_AUTO_RESOLVE_HOURS=72
#LOST_AND_FOUND_DENIED_AUTO_CLOSE_DAYS=7
#LOST_AND_FOUND_SHARE_CONTACT_DETAILS=true
#LOST_AND_FOUND_RETURN_FEE=0           # NGN, paid to the driver; 0 = off

# Advanced disputes (Phase 2, OQ-21) — super admins can override these at /admin/settings/disputes
#DISPUTES_TIER_1_REFUND_LIMIT=5000      # NGN per dispute, support
#DISPUTES_TIER_2_REFUND_LIMIT=50000     # NGN per dispute, support_lead
#DISPUTES_SAFETY_REFUND_LIMIT=50000     # NGN per dispute, safety_operator
#DISPUTES_SAFETY_FIRST_RESPONSE_MINUTES=60
#DISPUTES_SAFETY_RESOLUTION_HOURS=24
#DISPUTES_TIER_1_FIRST_RESPONSE_HOURS=24
#DISPUTES_TIER_1_RESOLUTION_HOURS=72
#DISPUTES_TIER_2_FIRST_RESPONSE_HOURS=24
#DISPUTES_TIER_2_RESOLUTION_HOURS=120
#DISPUTES_AUTO_ESCALATE_TIER_1=true
#DISPUTES_APPEAL_WINDOW_DAYS=7
#DISPUTES_MAX_EVIDENCE_FILES=10

# Multi-city launches (Phase 2, OQ-22) — operations can override these at /admin/settings/cities
#CITY_LAUNCH_MIN_APPROVED_DRIVERS=30   # approved, KYC-verified drivers before a city's first launch
#CITY_REQUIRE_EV_CHARGING=true         # a charging station when the city has plug-in drivers
#CITY_PAUSE_SCHEDULED_RIDES=honour     # honour or cancel upcoming bookings when a city is paused

# Social OAuth (Socialite — mobile app sends token, backend verifies via userFromToken)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI="${APP_URL}/auth/apple/callback"

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
PLACE_SEARCH_DRIVERS=google,mapbox,geoapify,locationiq,photon
PLACE_SEARCH_COUNTRY=ng
GEOAPIFY_API_KEY=
LOCATIONIQ_API_KEY=

FIREBASE_CREDENTIALS_PATH=storage/app/firebase/firebase-credentials.json
FIREBASE_PROJECT_ID=etogo-b08c2

NOTIFICATION_PUSH_ENABLED=true
NOTIFICATION_IN_APP_ENABLED=true
NOTIFICATION_MAIL_ENABLED=false
NOTIFICATION_RETENTION_DAYS=90
NOTIFICATION_MAX_PER_HOUR=30

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

QOREID_CLIENT_ID=
QOREID_SECRET_KEY=
QOREID_WEBHOOK_SECRET=
KYC_SKIP_VERIFICATION=false

VITE_APP_NAME="${APP_NAME}"

POSTMAN_API_KEY=
POSTMAN_COLLECTION_ID=
POSTMAN_WORKSPACE_ID=

# Token lifetimes in minutes: admin dashboard sessions, and passenger/driver app sessions
SANCTUM_TOKEN_EXPIRATION=480
SANCTUM_APP_TOKEN_EXPIRATION=43200

# Laravel Reverb (WebSocket server for real-time broadcasting)
REVERB_APP_ID=etigo
REVERB_APP_KEY=etigo-key
REVERB_APP_SECRET=etigo-secret
# Client-facing connection (for production behind nginx: use domain, port 443, https)
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Internal server bind address
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Keepalive tuning — ping clients every 25s, drop after 120s of silence
REVERB_APP_PING_INTERVAL=25
REVERB_APP_ACTIVITY_TIMEOUT=120

# Telemetry WebSocket Ingestion Gateway
TELEMETRY_SERVER_HOST=0.0.0.0
TELEMETRY_SERVER_PORT=8081
TELEMETRY_SERVER_WORKERS=4

