            "description": "No request body required. Returns 422 if the driver is not in approved status."
          }
        },
        {
          "name": "Suspend — Not Approved (422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/admin/drivers/1/suspend",
              "host": ["{{base_url}}"],
              "path": ["admin", "drivers", "1", "suspend"]
            },
            "description": "Expected: 422 {\"message\": \"Only approved drivers can be suspended.\"} — driver must be in approved status."
          }
        },
        {
          "name": "Reactivate Driver",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/admin/drivers/1/reactivate",
