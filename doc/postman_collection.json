              "raw": "{\n  \"provider\": \"google\",\n  \"access_token\": \"ya29.a0AfH6SM...\",\n  \"type\": \"passenger\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/social-login",
              "host": ["{{base_url}}"],
              "path": ["auth", "social-login"]
            },
            "description": "Replace access_token with a valid Google OAuth token. Returns 201 for new users, 200 for existing users."
          }
        },
