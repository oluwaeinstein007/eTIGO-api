              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{driver_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"licence_number\": \"AB123CDE\"\n}"
