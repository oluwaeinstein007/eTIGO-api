            "url": {
              "raw": "{{base_url}}/admin/drivers",
              "host": ["{{base_url}}"],
              "path": ["admin", "drivers"]
            }
          }
        },
        {
          "name": "List Pending Drivers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/admin/drivers/pending",
              "host": ["{{base_url}}"],
              "path": ["admin", "drivers", "pending"]
            }
          }
        },
        {
          "name": "Get Driver",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/admin/drivers/1",
              "host": ["{{base_url}}"],
              "path": ["admin", "drivers", "1"]
            }
          }
        },
        {
          "name": "Approve Driver",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"approve\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/drivers/1/review",
              "host": ["{{base_url}}"],
              "path": ["admin", "drivers", "1", "review"]
            },
            "description": "Returns 422 with message 'Driver can only be reviewed when in pending review status.' if the driver is not in pending_review status."
          }
        },
        {
          "name": "Reject Driver",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"reject\",\n  \"rejection_reason\": \"Documents are blurry and unreadable.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/drivers/1/review",
              "host": ["{{base_url}}"],
              "path": ["admin", "drivers", "1", "review"]
            }
          }
        },
        {
          "name": "Review — Not Pending (422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"approve\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/drivers/1/review",
              "host": ["{{base_url}}"],
              "path": ["admin", "drivers", "1", "review"]
            },
            "description": "Expected: 422 {\"message\": \"Driver can only be reviewed when in pending review status.\"} — use on a driver that is already approved/rejected/suspended."
          }
        },
        {
          "name": "Suspend Driver",
