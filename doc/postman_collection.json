            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{driver_token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "type", "value": "driving_licence", "type": "text" },
                { "key": "document", "type": "file", "src": "" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/driver/documents",
              "host": ["{{base_url}}"],
              "path": ["driver", "documents"]
            }
